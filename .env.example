# Template for .env — copy to .env and fill in. NEVER commit .env.
#
#   cp .env.example .env
#
# .env is git-ignored (.gitignore). This repository is PUBLIC, so a committed
# credential is a disclosed credential. If a key ever lands in a commit, treat
# it as compromised and roll it in the Cloudflare dashboard rather than trying
# to rewrite history.
#
# These credentials are needed ONLY to publish (upload) the corpus.
# Consuming it — `cli fetch` — is anonymous public-read and needs none of this.

# Cloudflare account ID. Dashboard -> R2 -> Overview, right-hand sidebar.
# The S3 endpoint is derived from it:
#   https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=

# R2 API token credentials.
# Dashboard -> R2 -> API -> Manage API Tokens -> Create API Token.
# Permission: "Object Read & Write". Scope it to the single bucket below,
# not to all buckets — this token only ever needs to write one prefix.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Target bucket name.
R2_BUCKET=fence-rag

# Public base URL for anonymous reads. Either the r2.dev subdomain enabled
# under Bucket -> Settings -> Public Development URL, or a custom domain.
# Must end with a slash. This value is PUBLIC and is baked into the generated
# distribution manifest — it is not a secret.
R2_PUBLIC_BASE_URL=
