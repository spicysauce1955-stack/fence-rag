+def test_seven_panel_corner_and_disconnected_run_buy_seven_kits_and_keep_all_geometry():
+    from fenceai.topology.model import Topology, Node, Run
+    from fenceai.fencemodel.library import FenceModelLibrary
+    from fenceai.fencemodel.selection import FenceModelChoice
+    from fenceai.knowledge.demo import demo_knowledge
+    from fenceai.strategy.generator import generate
+    from fenceai.demand.derive import derive_requirements
+    from fenceai.fulfillment.supply import resolve_supply
+    from fenceai.fulfillment.fulfill import fulfill
+    model, parts = _full_kit_model()
+    topology = Topology(nodes=[Node(id=key, x_mm=x, y_mm=y)
+        for key, x, y in [('a',0,0), ('b',4500,0), ('c',4500,3000), ('d',8000,0), ('e',11000,0)]],
+        runs=[Run(id=key, start_node_id=start, end_node_id=end)
+              for key, start, end in [('ab','a','b'), ('bc','b','c'), ('de','d','e')]])
+    catalog = demo_catalog()
+    result = generate(topology, demo_knowledge(), catalog,
+        models=FenceModelLibrary(models=[model]), parts=parts,
+        default_model=FenceModelChoice(model_id=model.id))
+    assert len(result.strategy.spans) == 7
+    assert len(result.strategy.posts) == 9
+    demand = derive_requirements(result.strategy, catalog)
+    resolution = resolve_supply(demand, catalog)
+    bom = fulfill(resolution.requirements, catalog)
+    assert sum(line.purchase_qty for line in bom.lines if line.sku == 'GATE-KIT-1000') == 7
+    assert not {'RAIL-3000', 'SLAT-100', 'HINGE-SET'} & {line.sku for line in bom.lines}
+    assert sum(_slot(span.panel, 'rail').qty for span in result.strategy.spans) == 14
+    assert sum(_slot(span.panel, key).qty for span in result.strategy.spans for key in ('first','last')) == 14
