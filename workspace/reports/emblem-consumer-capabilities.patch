diff --git a/tests/fencemodel/test_emblem_capabilities.py b/tests/fencemodel/test_emblem_capabilities.py
new file mode 100644
index 0000000..84813a1
--- /dev/null
+++ b/tests/fencemodel/test_emblem_capabilities.py
@@ -0,0 +1,290 @@
+"""Synthetic geometry only: these numbers are not Emblem manufacturer facts."""
+import pytest
+
+from fenceai.fencemodel.model import (
+    EdgeBinding, FixingRule, InfillSpec, Member, PanelSpec, PartRequirement,
+    ProfileEdges, validate_model,
+)
+from fenceai.fencemodel.resolve import PanelContext, resolve_panel
+from fenceai.parts.model import ContainedPart
+from fenceai.catalog.demo import demo_catalog as _demo_catalog
+from fenceai.core.errors import GenerationFailure
+from tests.fencemodel.test_containment import _parts, _spec, _model, _slot
+
+
+def demo_catalog():
+    catalog = _demo_catalog()
+    catalog.products["SLAT-100"].attrs["width_mm"] = 20
+    catalog.products["SLAT-100"].name = "Synthetic 20 mm board stock; not manufacturer data"
+    channel = catalog.products["HINGE-SET"].model_copy(deep=True)
+    channel.sku = "SYNTHETIC-END-CHANNEL"
+    channel.name = "Synthetic end channel; no manufacturer dimensions"
+    channel.attrs = {"type": "end_channel"}
+    catalog.products[channel.sku] = channel
+    return catalog
+
+
+def _priced(model, library):
+    from fenceai.demand.derive import derive_requirements
+    from fenceai.fencemodel.library import FenceModelLibrary
+    from fenceai.fencemodel.selection import FenceModelChoice
+    from fenceai.fulfillment.fulfill import fulfill
+    from fenceai.fulfillment.supply import resolve_supply
+    from fenceai.knowledge.demo import demo_knowledge
+    from fenceai.strategy.generator import generate
+    from tests.conftest import straight_topology
+    catalog = demo_catalog()
+    result = generate(straight_topology(3000), demo_knowledge(), catalog,
+                      models=FenceModelLibrary(models=[model]), parts=library,
+                      default_model=FenceModelChoice(model_id=model.id))
+    demand = derive_requirements(result.strategy, catalog)
+    resolution = resolve_supply(demand, catalog)
+    return result, resolution, fulfill(resolution.requirements, catalog)
+
+
+def _kit_model(count=2):
+    parts = _parts()
+    kit = next(p for p in parts.parts if p.id == 'kit-gate')
+    kit.contains = [ContainedPart(key='rails', part_id='rail-3000', qty=count, stock_length_mm=3000)]
+    spec = _spec(0, credits={'rails': 'rail'}, with_hinge_slot=False)
+    spec.fixings[0].requirement.geometry_credits = True
+    return _model(spec), parts
+
+
+@pytest.mark.parametrize('supplied,remaining', [(1, 1), (2, 0), (3, 0)])
+def test_geometry_credit_preserves_rails_and_reduces_real_demand(supplied, remaining):
+    model, parts = _kit_model(supplied)
+    assert validate_model(model, demo_catalog(), parts) == []
+    result, resolution, bom = _priced(model, parts)
+    for span in result.strategy.spans:
+        rail = _slot(span.panel, 'rail')
+        assert rail.qty == 2
+        assert len(rail.positions_mm) == 2
+        assert rail.purchase_qty == remaining
+        assert rail.credited_qty == min(supplied, 2)
+        contents = _slot(span.panel, 'kit/rails')
+        assert contents.qty == max(supplied - 2, 0)
+        assert contents.credited_qty == min(supplied, 2)
+    rails = [r for r in resolution.requirements if r.slot_key == 'rail']
+    assert sum(r.engineering_qty for r in rails) == remaining * len(result.strategy.spans)
+    assert any(line.sku == 'GATE-KIT-1000' for line in bom.lines)
+    if not remaining:
+        assert all(line.sku != 'RAIL-3000' for line in bom.lines)
+    for node in result.graph.nodes:
+        if node.action == 'credit_contained':
+            assert node.payload['of'] == 2
+            assert node.payload['remaining'] == remaining
+    covered = {p for line in bom.lines for p in line.pegs} | {p for a in bom.allocations for p in a.pegs}
+    assert covered == {r.id for r in resolution.requirements}
+
+
+def test_geometry_credit_requires_identical_part_and_noncontinuous_geometry():
+    model, parts = _kit_model()
+    next(p for p in parts.parts if p.id == 'kit-gate').contains[0].part_id = 'fix-hinge'
+    assert any('exact target Part ID' in e for e in validate_model(model, demo_catalog(), parts))
+    model, parts = _kit_model()
+    model.default_spec.frame[0].post_joint = 'through'
+    assert any('continuous members' in e for e in validate_model(model, demo_catalog(), parts))
+
+
+def _handed_spec():
+    return PanelSpec(infill=InfillSpec(
+        orientation='vertical', justification='start', excess='truncate',
+        pattern=[Member(key='board', width_mm=100, thickness_mm=10,
+                        profile_edges=ProfileEdges(start='tongue', end='groove'),
+                        requirement=PartRequirement(role='infill', qty=1))]),
+        fixings=[FixingRule(key=position, basis='per_panel', qty_per_basis=1,
+                           requirement=PartRequirement(role='end_channel', qty=1),
+                           edge_binding=EdgeBinding(member_key='board', position=position,
+                                                    profile_edge=edge))
+                 for position, edge in [('first', 'tongue'), ('last', 'groove')]])
+
+
+def _resolve(spec, width=500):
+    return resolve_panel(spec, PanelContext(centre_width_mm=width, clear_width_mm=width, height_mm=1000))
+
+
+def test_handed_bindings_follow_actual_fit_and_survive_serialization():
+    for width in (100, 500, 1000):
+        panel = _resolve(_handed_spec(), width)
+        assert _slot(panel, 'first').bound_position_mm == 0
+        assert _slot(panel, 'last').bound_position_mm == width
+        assert _slot(panel, 'board').qty == width // 100
+        assert _slot(panel, 'board').profile_edges.start == 'tongue'
+        dumped = panel.model_dump()
+        assert next(s for s in dumped['slots'] if s['slot_key'] == 'last')['edge_binding']['profile_edge'] == 'groove'
+
+
+@pytest.mark.parametrize('mutation', ['wrong_edge', 'wrong_member', 'empty_fit', 'multiple_pieces', 'positive_gap'])
+def test_handed_binding_refuses_ambiguous_or_impossible_fit(mutation):
+    spec = _handed_spec()
+    width = 500
+    if mutation == 'wrong_edge':
+        spec.fixings[0].edge_binding.profile_edge = 'groove'
+    elif mutation == 'wrong_member':
+        spec.fixings[0].edge_binding.member_key = 'absent'
+    elif mutation == 'empty_fit':
+        width = 1
+    elif mutation == 'multiple_pieces':
+        spec.infill.pattern[0].requirement.qty = 2
+    else:
+        spec.infill.pattern[0].gap_after_mm = 10
+    with pytest.raises(GenerationFailure):
+        _resolve(spec, width)
+
+
+def _full_kit_model():
+    from fenceai.parts.model import Part, SpecField
+    model, parts = _kit_model()
+    parts.parts.append(Part(id='synthetic-board', version=1, type='infill', spec=[
+        SpecField(key='sku', value=['SLAT-100'], agree='among'),
+        SpecField(key='width_mm', value=20, unit='mm')]))
+    parts.parts.append(Part(id="synthetic-end-channel", version=1, type="end_channel",
+        spec=[SpecField(key="sku", value=["SYNTHETIC-END-CHANNEL"], agree="among")]))
+    spec = _handed_spec()
+    spec.infill.pattern[0] = Member(key='board',
+        profile_edges=ProfileEdges(start='tongue', end='groove'),
+        requirement=PartRequirement(part_id='synthetic-board', qty=1, length_rule='panel_height'))
+    model.default_spec.infill = spec.infill
+    model.default_spec.infill.require_full_coverage = True
+    for fixing in spec.fixings:
+        fixing.requirement = PartRequirement(part_id='synthetic-end-channel', qty=1)
+    model.default_spec.fixings.extend(spec.fixings)
+    kit = next(p for p in parts.parts if p.id == 'kit-gate')
+    kit.contains.extend([
+        ContainedPart(key='boards', part_id='synthetic-board', qty=100, stock_length_mm=3000),
+        ContainedPart(key='first', part_id='synthetic-end-channel', qty=1),
+        ContainedPart(key='last', part_id='synthetic-end-channel', qty=1)])
+    model.default_spec.fixings[0].requirement.credits.update(
+        boards='board', first='first', last='last')
+    return model, parts
+
+
+def test_full_synthetic_kit_credits_boards_and_handed_channels_without_losing_geometry():
+    from fenceai.report.elevation import panel_elevation
+    model, parts = _full_kit_model()
+    assert validate_model(model, demo_catalog(), parts) == []
+    result, resolution, bom = _priced(model, parts)
+    assert not {'RAIL-3000', 'SLAT-100', 'SYNTHETIC-END-CHANNEL'} & {line.sku for line in bom.lines}
+    for span in result.strategy.spans:
+        board = _slot(span.panel, 'board')
+        assert board.qty > 1 and board.purchase_qty == 0
+        assert board.fit.residual_mm == 0
+        assert all(opening == 0 for opening in board.fit.openings_mm)
+        assert board.qty + _slot(span.panel, 'kit/boards').qty == 100
+        elevation = panel_elevation(span.panel, width_mm=span.clear_width_mm, height_mm=span.height_mm)
+        assert len([m for m in elevation.members if m.slot_key == 'board']) == board.qty
+        assert len([m for m in elevation.members if m.slot_key == 'rail']) == 2
+        for key in ('first', 'last'):
+            channel = _slot(span.panel, key)
+            assert channel.qty == 1 and channel.purchase_qty == 0
+            assert channel.role == "end_channel"
+            assert _slot(span.panel, 'kit/' + key).qty == 0
+            drawn = next(f for f in elevation.fixings if f.slot_key == key)
+            assert drawn.x_mm == channel.bound_position_mm
+            assert drawn.qty == 1
+
+
+def test_kit_cannot_credit_missing_or_insufficient_stock_length():
+    from tests.fencemodel.test_containment import _panel
+    for length in (None, 100):
+        model, parts = _kit_model()
+        next(p for p in parts.parts if p.id == 'kit-gate').contains[0].stock_length_mm = length
+        with pytest.raises(GenerationFailure, match='stock_length_mm'):
+            _panel(model, parts)
+
+
+def test_known_tongue_groove_cannot_mate_to_unknown_neighbor():
+    spec = _handed_spec()
+    spec.fixings = []
+    spec.infill.pattern[0].gap_after_mm = 10
+    spec.infill.pattern.append(Member(key="unknown", width_mm=100,
+                                     requirement=PartRequirement(role="infill")))
+    with pytest.raises(GenerationFailure, match="neighboring profile"):
+        _resolve(spec)
+
+
+def test_profiled_trim_policy_cannot_silently_leave_remainder():
+    spec = _handed_spec()
+    spec.infill.excess = "trim_last"
+    with pytest.raises(GenerationFailure, match="trimming is unsupported"):
+        _resolve(spec, 550)
+
+
+def test_seven_panel_corner_and_disconnected_run_buy_seven_kits_and_keep_all_geometry():
+    from fenceai.topology.model import Topology, Node, Run
+    from fenceai.fencemodel.library import FenceModelLibrary
+    from fenceai.fencemodel.selection import FenceModelChoice
+    from fenceai.knowledge.demo import demo_knowledge
+    from fenceai.strategy.generator import generate
+    from fenceai.demand.derive import derive_requirements
+    from fenceai.fulfillment.supply import resolve_supply
+    from fenceai.fulfillment.fulfill import fulfill
+    model, parts = _full_kit_model()
+    topology = Topology(nodes=[Node(id=key, x_mm=x, y_mm=y)
+        for key, x, y in [('a',0,0), ('b',4500,0), ('c',4500,3000), ('d',8000,0), ('e',11000,0)]],
+        runs=[Run(id=key, start_node_id=start, end_node_id=end)
+              for key, start, end in [('ab','a','b'), ('bc','b','c'), ('de','d','e')]])
+    catalog = demo_catalog()
+    result = generate(topology, demo_knowledge(), catalog,
+        models=FenceModelLibrary(models=[model]), parts=parts,
+        default_model=FenceModelChoice(model_id=model.id))
+    assert len(result.strategy.spans) == 7
+    assert len(result.strategy.posts) == 9
+    demand = derive_requirements(result.strategy, catalog)
+    resolution = resolve_supply(demand, catalog)
+    bom = fulfill(resolution.requirements, catalog)
+    assert sum(line.purchase_qty for line in bom.lines if line.sku == 'GATE-KIT-1000') == 7
+    assert not {'RAIL-3000', 'SLAT-100', 'SYNTHETIC-END-CHANNEL'} & {line.sku for line in bom.lines}
+    assert sum(_slot(span.panel, 'rail').qty for span in result.strategy.spans) == 14
+    assert sum(_slot(span.panel, key).qty for span in result.strategy.spans for key in ('first','last')) == 14
+
+
+def test_full_coverage_is_explicit_and_refuses_residual_without_inventing_trim():
+    spec = _handed_spec()
+    panel = _resolve(spec, 550)
+    assert _slot(panel, "board").fit.residual_mm == 50
