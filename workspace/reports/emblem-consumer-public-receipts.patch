+def test_actual_generation_cut_extent_demand_and_drawing_agree():
+    model, parts = fixture()
+    assert validate_model(model, demo_catalog(), parts) == []
+    result = generated(model, parts)
+    assert len(result.strategy.spans) == 2
+    checks = result.strategy.post_joint_checks
+    assert len(checks) == 2  # one physical shared post × two distinct rail heights
+    assert {check.rail_height_mm for check in checks} == {100, 1700}
+    assert all(check.engagements_mm == [25,20] for check in checks)
+    assert all(check.actual_gap_mm == check.required_gap_mm == 35 for check in checks)
+    assert len({check.post_id for check in checks}) == 1
+    for span in result.strategy.spans:
+        elevation = panel_elevation(span.panel, width_mm=span.clear_width_mm, height_mm=span.height_mm)
+        for rail in span.panel.slots:
+            assert rail.length_mm == 1465  # 1420 clear +20 start +25 end
+            assert rail.span_start_mm == -20
+            drawn = next(member for member in elevation.members if member.slot_key == rail.slot_key)
+            assert drawn.x_mm == -20 and drawn.w_mm == rail.length_mm
+    lines = [line for line in derive_requirements(result.strategy, demo_catalog()) if line.role=='rail']
+    assert len(lines) == 4
+    assert all(line.cut_length_mm == 1465 and line.engineering_qty == 1 for line in lines)
