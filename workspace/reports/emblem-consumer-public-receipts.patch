+        spec=[SpecField(key='sku', value=['RAIL-3000'], agree='among'),
+              SpecField(key='thickness_mm', value=40, unit='mm')])])
+    model = FenceModel(id='SYNTHETIC-POST-RECEIVER', version=1,
+        post=PostSlot(receiving_joint=ReceivingPostJoint(channel_depth_mm=30,
+            insertion_margin_mm=5, shared_host_gap_mm=35),
+            requirement=PartRequirement(role='post', eligibility=Eligibility(
+                members=[EligibleItem(sku='POST-S')]))),
+        default_spec=PanelSpec(frame=[FrameSlot(key=key, orientation='horizontal',
+            placement=FromBottom(offset_mm=height), post_joint='lands',
