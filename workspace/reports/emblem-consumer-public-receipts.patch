+            errors.append("Full coverage requires nonempty infill and nonnegative edge margins")
+        seen = set()
+        for fixing in spec.fixings:
+            binding = fixing.edge_binding
+            if binding is None:
+                continue
+            if binding.position in seen:
+                errors.append(f"fixing {fixing.key}: duplicate handed binding at {binding.position} edge")
+            seen.add(binding.position)
+            if (fixing.basis != "per_panel" or fixing.qty_per_basis != 1
+                    or fixing.requirement.qty != 1 or fixing.qty_param):
+                errors.append(f"fixing {fixing.key}: handed binding requires exactly one per-panel piece")
+            member = members.get(binding.member_key)
