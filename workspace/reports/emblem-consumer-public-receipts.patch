+"""Source-independent post receiving mechanics; all dimensions are synthetic."""
+import pytest
+
+from fenceai.catalog.demo import demo_catalog
+from fenceai.core.errors import GenerationFailure
+from fenceai.fencemodel.library import FenceModelLibrary
+from fenceai.fencemodel.model import (FenceModel, PostSlot, ReceivingPostJoint,
+    FrameSlot, FromBottom, PartRequirement, PanelSpec, Eligibility, EligibleItem,
+    validate_model)
