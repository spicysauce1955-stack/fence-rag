+"""Public Part identity/provenance survives ingestion without private activation."""
+from copy import deepcopy
+
+import pytest
+from pydantic import ValidationError
+
+from fenceai.knowledge.parts import Part
+from fenceai.knowledge.snapshot import Snapshot, ingest
+from tests.knowledge.test_parts import _doc, _length, _rail
+
+
+@pytest.mark.parametrize('version', [1, 2, '1', 'sha256:' + 'a' * 64, 'edition-B'])
+def test_public_versions_preserve_type_and_value(version):
+    raw = _rail(_length()).model_dump(mode='json')
+    raw['version'] = version
+    part = Part.model_validate(raw)
+    assert part.version == version
+    assert type(part.version) is type(version)
+    assert part.model_dump(mode='json') == raw
+
+
+@pytest.mark.parametrize('version', [True, False, 1.0, 1.5, 0, -1, '', '  ', None, [], {}])
+def test_public_versions_refuse_coercion_or_empty_identity(version):
+    raw = _rail(_length()).model_dump(mode='json')
+    raw['version'] = version
+    with pytest.raises(ValidationError):
+        Part.model_validate(raw)
+
+
+def test_draft_and_retired_parts_are_receipted_without_becoming_generation_inputs():
+    parts = [_rail(_length(), part_id='fixture/' + status, status=status)
+             for status in ('draft', 'retired')]
+    parts[0].version = 'sha256:' + 'a' * 64
+    snapshot = Snapshot(snapshot_id='FIXTURE-public-parts', parts=parts, source_docs=[_doc()])
+    before = deepcopy(snapshot.model_dump(mode='json'))
+    receipt = ingest(snapshot)
+    assert receipt.inactive_parts == ['fixture/draft', 'fixture/retired']
+    assert receipt.part_specs == []
+    assert [p.model_dump(mode='json') for p in receipt.published_parts] == before['parts']
+    assert [d.model_dump(mode='json') for d in receipt.source_docs] == before['source_docs']
+    receipt.published_parts[0].spec[0].value.value_raw.append('mutated copy')
+    receipt.source_docs[0].source_class = 'mutated copy'
+    assert snapshot.model_dump(mode='json') == before
+
+
+def test_judged_spec_retains_version_and_all_original_provenance():
+    part = _rail(_length())
+    part.version = 'fixture-revision'
+    snapshot = Snapshot(snapshot_id='FIXTURE-public-parts', parts=[part], source_docs=[_doc()])
+    before = deepcopy(snapshot.model_dump(mode='json'))
+    receipt = ingest(snapshot)
+    spec = receipt.part_specs[0]
+    assert spec.part_version == part.version
+    assert spec.provenance == part.spec[0].provenance
+    assert spec.value == part.spec[0].value
+    assert spec.admitted_by is not None
+    assert any(g.because.code == 'published_spec_unapplied' for g in receipt.gaps)
+    spec.value.value_raw.append('mutated copy')
+    spec.provenance.cites[0].id = 'mutated copy'
+    assert snapshot.model_dump(mode='json') == before
