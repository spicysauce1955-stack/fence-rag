+"""A receipt's admission date must not alias its input source document."""
+from copy import deepcopy
+
+from fenceai.core.dates import Date
+from fenceai.knowledge.snapshot import Snapshot, ingest
+from tests.knowledge.test_parts import _doc, _length, _rail
+
+
+def test_admission_date_mutation_does_not_change_the_published_snapshot():
+    snapshot = Snapshot(
+        snapshot_id='FIXTURE-public-part-date',
+        parts=[_rail(_length())],
+        source_docs=[_doc(issue_date=Date(iso='2026-09-07', value_raw=['7 September 2026']))],
+    )
+    before = deepcopy(snapshot.model_dump(mode='json'))
+    receipt = ingest(snapshot)
+    date = receipt.part_specs[0].admitted_by.issue_date
+    assert date == snapshot.source_docs[0].issue_date
+    assert date is not snapshot.source_docs[0].issue_date
+    date.iso = '2020-01-01'
+    date.value_raw.append('mutated copy')
+    assert snapshot.model_dump(mode='json') == before
+    assert receipt.source_docs[0].issue_date.iso == '2026-09-07'
